# Complete VPS environment template for the current hex-bridge/hex-relay runtime.
# Install path on VPS: /etc/<PROJECT_NAME>/secrets.env
# Keep this file as a template only. Do not commit real tokens, private keys, or IDs.

# === Project identity ===
PROJECT_NAME=<project-name>
PROJECT_DIR=/srv/<project-name>/repo
SERVICE_PREFIX=<project-name>
BOT_USER=<linux-bot-user>

# === Telegram bot ===
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_CHAT_ID=<operator-chat-id-numeric>

# === Local relay HTTP ===
RELAY_HOOK_PORT=8090
RELAY_HTTP_TOKEN=<random-32-plus-character-token>

# === Logging and Telegram progress policy ===
LOG_LEVEL=info
RELAY_VERBOSITY=normal
RELAY_INBOUND_REACTIONS=

# === Idle-session watchdog ===
RELAY_IDLE_SHUTDOWN_SEC=600
RELAY_IDLE_TICK_SEC=60
RELAY_IDLE_BOOT_GRACE_SEC=120

# === Voice transcription ===
RELAY_VOICE_TRANSCRIPTION=off
FFMPEG_BIN=ffmpeg
WHISPER_CPP_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-small-q5_1.bin
RELAY_VOICE_MAX_DURATION_SEC=90
RELAY_VOICE_TRANSCRIBE_TIMEOUT_SEC=120

# === Git provider task polling ===
GIT_PROVIDER=github
REPO_SLUG=<owner/repo-or-gitlab-namespace/project>

# === GitHub App (only when GIT_PROVIDER=github) ===
GITHUB_APP_ID=<numeric-app-id>
GITHUB_INSTALLATION_ID=<numeric-installation-id>
GITHUB_APP_PRIVATE_KEY_PATH=/etc/<PROJECT_NAME>/github-app.pem

# === GitLab (only when GIT_PROVIDER=gitlab) ===
GITLAB_HOST=gitlab.example.com
GITLAB_GIT_USERNAME=<gitlab-username-or-deploy-token-user>
GITLAB_GIT_TOKEN=<git-token-with-read-write-repository-scopes>
GITLAB_API_TOKEN=<glpat-api-token>

# === Cloudflare (optional; leave blank to disable Cloudflare-related ops) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_NAME=

# === MCP server keys (optional; leave blank to skip the corresponding server) ===
REF_API_KEY=
CONTEXT7_API_KEY=
