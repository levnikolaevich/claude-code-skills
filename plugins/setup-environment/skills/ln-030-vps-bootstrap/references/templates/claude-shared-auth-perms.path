[Unit]
Description=Watch shared Claude/Codex auth files for permission repair
ConditionPathExists=/var/lib/claude-shared

[Path]
PathChanged=/var/lib/claude-shared/.claude/.credentials.json
PathChanged=/var/lib/claude-shared/.claude.json
PathChanged=/var/lib/claude-shared/.codex/auth.json
Unit=claude-shared-auth-perms.service

[Install]
WantedBy=multi-user.target
